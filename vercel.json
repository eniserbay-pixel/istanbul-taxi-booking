{
  "buildCommand": "node build/build.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "crons": [{ "path": "/api/admin?a=tgdaily", "schedule": "0 17 * * *" }],
  "functions": { "api/*.js": { "includeFiles": "{data/**,public/assets/quote.js,api/_lib/voucher/**}" } },
  "rewrites": [
    { "source": "/api/hit", "destination": "/api/lead?hit=1" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/((?!admin).*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/b2b(/.*)?", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }, { "key": "X-Frame-Options", "value": "DENY" }] },
    { "source": "/admin(.*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }, { "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
